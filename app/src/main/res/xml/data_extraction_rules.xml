<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (API 31). Defines what the OS will
    upload to cloud backups and what gets moved during device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="food_tracker.db" />
        <include domain="file" path="datastore/user_prefs.preferences_pb" />
        <include domain="file" path="datastore/reminder_prefs.preferences_pb" />
    </cloud-backup>

    <device-transfer>
        <include domain="database" path="food_tracker.db" />
        <include domain="file" path="datastore/user_prefs.preferences_pb" />
        <include domain="file" path="datastore/reminder_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
