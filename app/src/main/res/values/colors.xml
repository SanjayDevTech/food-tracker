<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Launcher icon layers. The foreground is AppPrimary, kept in sync with
         ui/theme/Color.kt so the mark moves with the palette instead of
         stranding an old accent on the home screen. The background is black
         rather than the old primaryContainer tile: the app canvas is black and
         house rule 3 keeps the accent for data, so the icon says the same. -->
    <color name="ic_launcher_foreground">#FF63D2B0</color>
    <color name="ic_launcher_background">#FF000000</color>

    <!-- Window + splash background. Black, because the app's canvas is black:
         anything else is a flash of a colour the app does not contain. There is
         no values-night override any more — the app is dark-only, so one table
         is correct in both system modes. -->
    <color name="launcher_background">#FF000000</color>
    <color name="splash_background">#FF000000</color>
</resources>
