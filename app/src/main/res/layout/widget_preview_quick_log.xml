<?xml version="1.0" encoding="utf-8"?>
<!--
  Quick-log preview — header + meal pills row + recent foods row. Same
  three-row structure as the live widget so picker and placed widget read
  identically. RemoteViews-compatible (no <Space>, no <View>).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_preview_bg_surface"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUICK LOG"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/widget_on_surface_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="What did you just eat?"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/widget_on_surface"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_preview_fab">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="+"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/widget_on_primary"
                android:gravity="center" />
        </FrameLayout>
    </LinearLayout>

    <!-- Meal pills row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/widget_preview_pill">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Breakfast"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/widget_on_pill"
                android:gravity="center" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/widget_preview_pill"
            android:layout_marginStart="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Lunch"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/widget_on_pill"
                android:gravity="center" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/widget_preview_pill"
            android:layout_marginStart="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Snack"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/widget_on_pill"
                android:gravity="center" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/widget_preview_pill"
            android:layout_marginStart="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Dinner"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/widget_on_pill"
                android:gravity="center" />
        </FrameLayout>
    </LinearLayout>

    <!-- Recent foods row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/widget_preview_chip">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Idli"
                android:textSize="11sp"
                android:textColor="@color/widget_on_chip"
                android:gravity="center"
                android:maxLines="1" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/widget_preview_chip"
            android:layout_marginStart="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Sambar"
                android:textSize="11sp"
                android:textColor="@color/widget_on_chip"
                android:gravity="center"
                android:maxLines="1" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/widget_preview_chip"
            android:layout_marginStart="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Curd"
                android:textSize="11sp"
                android:textColor="@color/widget_on_chip"
                android:gravity="center"
                android:maxLines="1" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
