<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget color tokens — NIGHT variant. Mirrors the role mapping in
  values/colors_widget.xml but with the dark-theme indices in the
  Material You ramp.
-->
<resources>
    <color name="widget_surface">@android:color/system_neutral2_700</color>
    <color name="widget_on_surface">@android:color/system_neutral1_100</color>
    <color name="widget_on_surface_muted">@android:color/system_neutral2_200</color>

    <color name="widget_primary_container">@android:color/system_accent1_700</color>
    <color name="widget_on_primary_container">@android:color/system_accent1_100</color>

    <color name="widget_primary">@android:color/system_accent1_200</color>
    <color name="widget_on_primary">@android:color/system_accent1_800</color>

    <color name="widget_primary_subtle">@android:color/system_accent1_400</color>

    <!-- Meal pill — `system_accent1_300` (brighter than the default _700
         primaryContainer) so it's clearly visible against the `_700`
         surfaceVariant. Tracks wallpaper extraction, just at a higher
         brightness step. -->
    <color name="widget_pill">@android:color/system_accent1_300</color>
    <color name="widget_on_pill">@android:color/system_accent1_900</color>

    <!-- Recent food chip — neutral lift. `_200` is clearly brighter than
         the `_700` surfaceVariant base. -->
    <color name="widget_chip">@android:color/system_neutral1_200</color>
    <color name="widget_on_chip">@android:color/system_neutral1_900</color>

    <!-- Success / "just logged" tap feedback — Material You tertiary. Use a
         brighter step in dark so it pops against the deep surfaceVariant. -->
    <color name="widget_success">@android:color/system_accent3_300</color>
    <color name="widget_on_success">@android:color/system_accent3_900</color>
</resources>
