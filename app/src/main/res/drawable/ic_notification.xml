<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar small icon for reminder notifications. Same bowl + steam motif as
  the launcher mark, redrawn in a tight 24×24 viewport so it stays legible at
  status-bar size. White fill — the Android notification system tints this with
  the channel/notification accent.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Bowl body: half-ellipse sitting in the lower portion of the viewport. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M3,13 L21,13 C21,17.5 17,21 12,21 C7,21 3,17.5 3,13 Z" />

    <!-- Centre steam wisp. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M12,10 C10,8 14,6 12,3" />

    <!-- Left steam wisp. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M8,10 C6.5,8.5 9.5,7 8,4.5" />

    <!-- Right steam wisp. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M16,10 C14.5,8.5 17.5,7 16,4.5" />
</vector>
