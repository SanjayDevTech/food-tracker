<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed-icon monochrome layer (Android 13+). Same geometry as the foreground;
  the system extracts these white pixels and tints them with the user's theme
  colour, so the shapes are repeated here rather than shared.

  The adaptive icon previously pointed <monochrome> at the foreground drawable
  itself. That works — only the alpha mask is read — but it silently couples the
  themed icon to the accent-coloured layer, so any later use of a second colour
  in the foreground would have changed the themed icon's silhouette with no
  obvious cause. A dedicated layer keeps that explicit.

  Keyline maths lives in ic_launcher_foreground.xml; keep the two in step.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="@android:color/white"
        android:pathData="M39,32 a2,2 0 0 1 2,2 v16 h-4 v-16 a2,2 0 0 1 2,-2 Z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M46,32 a2,2 0 0 1 2,2 v16 h-4 v-16 a2,2 0 0 1 2,-2 Z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M53,32 a2,2 0 0 1 2,2 v16 h-4 v-16 a2,2 0 0 1 2,-2 Z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M37,46 h18 v6 a5,5 0 0 1 -5,5 h-8 a5,5 0 0 1 -5,-5 Z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M44,54 h4 v20 a2,2 0 0 1 -2,2 a2,2 0 0 1 -2,-2 Z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M61,33 a1,1 0 0 1 1.3,-0.95 c4.5,2.6 7.7,9.6 7.7,17.95 c0,2.6 -1.6,4 -4,4 h-5 Z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M61,52 h4 v22 a2,2 0 0 1 -2,2 a2,2 0 0 1 -2,-2 Z" />
</vector>
