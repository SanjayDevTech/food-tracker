<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed-icon monochrome layer (Android 13+). Same geometry as the foreground;
  the system extracts these white pixels and tints them with the user's theme
  colour, so the shapes are repeated here rather than shared.

  The adaptive icon previously pointed <monochrome> at the foreground drawable
  itself. That works — only the alpha mask is read — but it silently couples the
  themed icon to the accent-coloured layer, so any later use of a second colour
  in the foreground would have changed the themed icon's silhouette with no
  obvious cause. A dedicated layer keeps that explicit.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="@android:color/white"
        android:pathData="M46,37 a2,2 0 0 1 2,2 v8 a2,2 0 0 1 -2,2 a2,2 0 0 1 -2,-2 v-8 a2,2 0 0 1 2,-2 Z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M54,31 a2,2 0 0 1 2,2 v14 a2,2 0 0 1 -2,2 a2,2 0 0 1 -2,-2 v-14 a2,2 0 0 1 2,-2 Z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M62,40 a2,2 0 0 1 2,2 v5 a2,2 0 0 1 -2,2 a2,2 0 0 1 -2,-2 v-5 a2,2 0 0 1 2,-2 Z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M28,52 h52 a2,2 0 0 1 2,2 a2,2 0 0 1 -2,2 h-52 a2,2 0 0 1 -2,-2 a2,2 0 0 1 2,-2 Z" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M32,56 A22,22 0 0 0 76,56 Z" />
</vector>
