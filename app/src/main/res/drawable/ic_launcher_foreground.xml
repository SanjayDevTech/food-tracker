<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground: a bowl under a rule, with three rising marks.

  Built from the app's own primitives rather than drawn as an illustration, the
  way GymTracker's barbell is a 4dp bar carrying plates:
    - the rim is the 4dp rule house rule 1 puts under every standing head, run
      past the bowl on both sides so it reads as a rule and not as a lip;
    - the three marks above it are the Meter stack from Today's macro rows at
      the sizes they actually appear, so the thing that says "steam" at 48dp is
      the same thing that says "tracking" when you look twice.

  Flat, one colour, no gradient and no shadow — the previous mark drew its steam
  with stroked bezier wisps, which is the only curve-for-its-own-sake left in
  the app after the rewrite.

  Geometry on the 108dp canvas, centred on (54,54):
    steam   x44..48 / x52..56 / x60..64, bottoms aligned at y49, r2
    rim     x26..82, y52..56, r2
    bowl    half-disc, centre (54,56), radius 22, so y56..78
  Extents x26..82, y31..78. Farthest point is a rim corner at 28.1dp from
  centre, inside the 33dp safe-zone radius, so no mask crops it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Steam / meter marks, short to tall to short. -->
    <path
        android:fillColor="@color/ic_launcher_foreground"
        android:pathData="M46,37 a2,2 0 0 1 2,2 v8 a2,2 0 0 1 -2,2 a2,2 0 0 1 -2,-2 v-8 a2,2 0 0 1 2,-2 Z" />
    <path
        android:fillColor="@color/ic_launcher_foreground"
        android:pathData="M54,31 a2,2 0 0 1 2,2 v14 a2,2 0 0 1 -2,2 a2,2 0 0 1 -2,-2 v-14 a2,2 0 0 1 2,-2 Z" />
    <path
        android:fillColor="@color/ic_launcher_foreground"
        android:pathData="M62,40 a2,2 0 0 1 2,2 v5 a2,2 0 0 1 -2,2 a2,2 0 0 1 -2,-2 v-5 a2,2 0 0 1 2,-2 Z" />

    <!-- The rule. -->
    <path
        android:fillColor="@color/ic_launcher_foreground"
        android:pathData="M28,52 h52 a2,2 0 0 1 2,2 a2,2 0 0 1 -2,2 h-52 a2,2 0 0 1 -2,-2 a2,2 0 0 1 2,-2 Z" />

    <!-- Bowl. -->
    <path
        android:fillColor="@color/ic_launcher_foreground"
        android:pathData="M32,56 A22,22 0 0 0 76,56 Z" />
</vector>
